{
  "manifest_version": 3,
  "name": "FlipBrief - Add YouTube",
  "version": "0.1.0",
  "description": "Add YouTube videos and playlists to FlipBrief.",
  "permissions": ["activeTab", "tabs", "storage", "notifications"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to FlipBrief",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
