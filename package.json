{
  "name": "flipbrief",
  "version": "0.1.0",
  "description": "Mac app and Chrome connector that turn YouTube videos into concise visual flipbooks.",
  "main": "./out/main/index.js",
  "author": "Chris DiMarco",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-main-modules.mjs",
    "preview": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.chrisdimarco.flipbrief",
    "productName": "FlipBrief",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.icns"
    },
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    }
  }
}
